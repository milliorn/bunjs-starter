{
  "name": "bun-starter",
  "module": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --hot --watch server.ts",
    "hot": "bun --hot server.ts",
    "start": "bun run server.ts",
    "watch": "bun --watch server.ts",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test",
    "test:server": "bun test __tests__/server.test.ts"
  },
  "devDependencies": {
    "bun-types": "1.4.3",
    "typescript": "5.9.3"
  }
}
